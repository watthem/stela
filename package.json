{
  "name": "@watthem/stela",
  "version": "0.2.0",
  "description": "Git blame for AI answers \u2014 document preprocessing with provenance tracking",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "stela": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm test"
  },
  "keywords": [
    "rag",
    "chunking",
    "provenance",
    "preprocessing",
    "llm",
    "compliance",
    "audit",
    "source-provenance",
    "citations"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/watthem/stela.git"
  },
  "homepage": "https://github.com/watthem/stela",
  "bugs": {
    "url": "https://github.com/watthem/stela/issues"
  },
  "author": "Matthew Hendricks",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
